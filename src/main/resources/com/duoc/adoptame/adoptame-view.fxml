<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1024.0" prefHeight="720.0" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.duoc.adoptame.controller.AdoptameController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <Label text="Centro de Adopción Huella Segura"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TitledPane text="Registro de animales" expanded="true" animated="false">
        <content>
            <GridPane hgap="10.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="90.0" prefWidth="90.0"/>
                    <ColumnConstraints minWidth="180.0" prefWidth="180.0"/>
                    <ColumnConstraints minWidth="110.0" prefWidth="110.0"/>
                    <ColumnConstraints minWidth="140.0" prefWidth="140.0" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="tipoComboBox" promptText="Seleccione tipo" prefWidth="180.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="nombreField" promptText="Nombre del animal"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Año:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="anioField" promptText="Ej.: 2022"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Edad (años):" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <TextField fx:id="edadField" promptText="Ej.: 4"
                           GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <VBox fx:id="datosPerroBox" spacing="6.0"
                      GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="4">
                    <Label text="Datos del perro" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="Raza:" minWidth="70.0"/>
                        <TextField fx:id="razaField" promptText="Raza" prefWidth="150.0"/>
                        <CheckBox fx:id="vacunasCheckBox" text="Vacunas al día"/>
                        <CheckBox fx:id="aptoNinosCheckBox" text="Apto para niños"/>
                    </HBox>
                </VBox>

                <VBox fx:id="datosGatoBox" spacing="6.0"
                      GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="4">
                    <Label text="Datos del gato" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="Sociabilidad (1,0 a 5,0):" minWidth="180.0"/>
                        <TextField fx:id="sociabilidadField" promptText="Ej.: 4,5" prefWidth="120.0"/>
                    </HBox>
                </VBox>

                <Button fx:id="registrarButton" text="Registrar" onAction="#onRegistrar"
                        GridPane.columnIndex="3" GridPane.rowIndex="5"/>
            </GridPane>
        </content>
    </TitledPane>

    <Label text="Animales registrados" style="-fx-font-weight: bold;"/>

    <TableView fx:id="tablaAnimales" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colEspecie" text="Especie" prefWidth="100.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="140.0"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="80.0"/>
            <TableColumn fx:id="colEdad" text="Edad (años)" prefWidth="110.0"/>
            <TableColumn fx:id="colCuota" text="Cuota estimada" prefWidth="140.0"/>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button fx:id="eliminarButton" text="Eliminar" onAction="#onEliminar"/>
    </HBox>

    <Label text="Mensajes:" style="-fx-font-weight: bold;"/>
    <Label fx:id="mensajeLabel" text="" wrapText="true" minHeight="32.0"
           style="-fx-border-color: #cccccc; -fx-border-radius: 4; -fx-padding: 6;"/>
</VBox>
